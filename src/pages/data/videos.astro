---
const videos = [
  {
    title: 'Le piège du pivot dans Power Query',
    desc: "Une erreur rencontrée lors d'un pivot dans Power Query — subtile et facile à reproduire sans s'en rendre compte. Une vidéo de 10 minutes, simple et rapide, pour comprendre le piège et l'éviter.",
    note: 'PS : toute ressemblance avec des personnages réels serait fortuite (Arnaud Gastelblum 😉)',
    src: '/power-query-pivot-secrets.mp4',
  },
];
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Vidéos de Matthieu Rancinan — Power BI, Power Query et data." />
    <title>Vidéos — Matthieu Rancinan</title>
  </head>
  <body>
    <main>
      <nav class="topnav"><a href="/data">← Réalisations Data</a></nav>
      <header>
        <div class="badge">Power Query</div>
        <h1>Vidéos</h1>
        <p class="tagline">Astuces, pièges et retours d'expérience — Power BI et Power Query.</p>
      </header>

      {videos.map((v) => (
        <section class="video-card">
          <h2>{v.title}</h2>
          <p class="desc">{v.desc}</p>
          <video controls playsinline preload="metadata">
            <source src={v.src} type="video/mp4" />
          </video>
          {v.note && <p class="note">{v.note}</p>}
        </section>
      ))}

      <footer>
        <p><a href="/data">← Réalisations Data</a></p>
        <p class="copy">© {new Date().getFullYear()} Matthieu Rancinan</p>
      </footer>
    </main>
    <style is:global>
      :root { color-scheme: dark; --bg: #2a1b14; --bg-card: #3a2620; --fg: #f5e6d5; --muted: #b8a491; --border: #4a332a; --accent: #8b9d7e; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { background: radial-gradient(circle at 20% 0%, #4a2a1d 0%, var(--bg) 60%); color: var(--fg); font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; min-height: 100vh; }
      main { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem; }
      .topnav { margin-bottom: 2rem; font-size: 0.9rem; }
      .topnav a { color: var(--muted); text-decoration: none; }
      .topnav a:hover { color: var(--fg); }
      .badge { display: inline-block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0.2rem 0.6rem; margin-bottom: 1rem; }
      h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 0.5rem; letter-spacing: -0.02em; }
      .tagline { color: var(--muted); font-size: 1.1rem; margin: 0 0 2.5rem; }
      .video-card { background: var(--bg-card); border: 1px solid var(--border); border-top: 3px solid var(--accent); border-radius: 14px; padding: 1.5rem; margin-bottom: 2rem; }
      .video-card h2 { margin: 0 0 0.75rem; font-size: 1.4rem; }
      .desc { color: var(--fg); line-height: 1.6; margin: 0 0 1.25rem; }
      video { width: 100%; border-radius: 10px; background: #000; display: block; max-height: 520px; }
      .note { color: var(--muted); font-size: 0.85rem; font-style: italic; margin: 1rem 0 0; }
      footer { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1.5rem; text-align: center; color: var(--muted); font-size: 0.9rem; }
      footer a { color: var(--fg); text-decoration: none; border-bottom: 1px dashed var(--muted); }
      .copy { margin-top: 0.5rem; font-size: 0.8rem; }
    </style>
  </body>
</html>
