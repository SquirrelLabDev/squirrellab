    students: ['Margaux Leroy', 'Eléonore Tran', 'Nina Tuil', 'Julien Lin'],
  },
  {
    ep: 9,
    title: "L'immobilier",
    desc: 'Un sujet qui en intéresse plus d’un : l’immobilier. Le tout porté par un design osé.',
    src: 'https://app.powerbi.com/view?r=eyJrIjoiYmQyMTBjNmQtNTEzOC00ZTU2LTk4N2YtOGQyNTA5ZTliY2RlIiwidCI6Ijk1MWQxZWNhLTk2MGYtNDUwMS05MGY4LThkN2RhYjM0NjBkNiIsImMiOjh9',
    students: ['Walid L.', 'Naïm M.', 'Nicolas Pereira', 'David Veillepeau'],
  },
  {
    ep: 10,
    title: 'La politique',
    desc: "L'impact des différents présidents sur les 30 dernières années — et du son, comme dans l'épisode Pokémon. Bluffant !",
    src: 'https://app.powerbi.com/view?r=eyJrIjoiZTI0ZDEzNzctNjNmNS00OTc5LWEwY2YtODgzNTBkODNkODFkIiwidCI6Ijk1MWQxZWNhLTk2MGYtNDUwMS05MGY4LThkN2RhYjM0NjBkNiIsImMiOjh9',
    students: ['Naya Cessot', 'Maxence Gatard', 'Myriam Haoudi', 'Jean-Cédric Le Philippe'],
