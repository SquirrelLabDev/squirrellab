---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Dashboards Power BI de Matthieu Rancinan — CV interactif et escape game data." />
    <title>Rapports Power BI — Matthieu Rancinan</title>
  </head>
  <body>
    <main>
      <nav class="topnav">
        <a href="/data">← Réalisations Data</a>
      </nav>

      <header class="hero">
        <div class="badge">Power BI</div>
        <h1>Rapports Power BI</h1>
        <p class="tagline">Visualisations interactives et expérimentations data.</p>
      </header>

      {dashboards.map((d) => (
        <section class="dashboard">
          <h2>{d.title}</h2>
          <Fragment set:html={d.html} />
        </section>
      ))}

      <section class="wc-section">
        <div class="wc-header">
          <div class="badge">World Challenge Dataviz</div>
          <h2>World Challenge Dataviz — Microsoft</h2>
          <p class="tagline-sub">
            Participation au concours hebdomadaire Power BI DataViz World Challenge organisé
            par Microsoft — un thème imposé chaque semaine, une visualisation à créer.
          </p>
        </div>

        {worldChallengeReports.map((w) => (
          <div class="wc-card">
            <h3>Semaine {w.week} — {w.title}</h3>
            <p class="desc">{w.desc}</p>
            <div class="embed-wrapper">
              <iframe
                class="embed"
                title={w.iframeTitle}
                src={w.src}
                loading="lazy"
                allowfullscreen
              ></iframe>
              <p class="embed-note">
                <a href={w.src} target="_blank" rel="noopener">Ouvrir en plein écran ↗</a>
              </p>
            </div>
            {w.note && <p class="wc-note">{w.note}</p>}
          </div>
        ))}
      </section>

      <section class="ece-section">
        <div class="ece-header">
          <div class="badge">Formation ECE</div>
          <h2>Projets étudiants — École d'ingénieurs</h2>
          <p class="tagline-sub">
            10 rapports Power BI réalisés de A à Z par mes étudiants de l'ECE (choix des données,
            modélisation, mise en forme). Chaque semaine, une découverte présentée sur LinkedIn.
          </p>
        </div>

        <div class="carousel" id="ece-carousel">
          <div class="carousel-track">
            {eceReports.map((r, i) => (
              <article class="slide" data-index={i}>
                <div class="slide-meta">
                  <span class="ep-badge">ECE épisode #{r.ep}</span>
                  <h3>{r.title}</h3>
                  <p class="slide-desc">{r.desc}</p>
                  <p class="students">
                    <span class="students-label">Bravo à :</span> {r.students.join(', ')}
                  </p>
                  <a href={r.src} target="_blank" rel="noopener" class="btn-open">Ouvrir en plein écran ↗</a>
                </div>
                <div class="slide-embed">
                  <iframe
                    class="embed"
                    title={r.title}
                    src={r.src}
                    loading="lazy"
                    allowfullscreen
                  ></iframe>
                </div>
              </article>
            ))}
          </div>

          <button class="nav prev" id="ece-prev" aria-label="Rapport précédent">‹</button>
          <button class="nav next" id="ece-next" aria-label="Rapport suivant">›</button>

          <div class="dots" id="ece-dots">
            {eceReports.map((_, i) => (
              <button class="dot" data-index={i} aria-label={`Aller au rapport ${i + 1}`}></button>
            ))}
          </div>
        </div>
      </section>

      <footer>
        <p><a href="/data">← Réalisations Data</a></p>
        <p class="copy">© {new Date().getFullYear()} Matthieu Rancinan</p>
      </footer>
    </main>

    <script>
      const track = document.querySelector('#ece-carousel .carousel-track') as HTMLElement | null;
      const slides = document.querySelectorAll('#ece-carousel .slide');
      const dots = document.querySelectorAll('#ece-dots .dot');
      const prevBtn = document.getElementById('ece-prev');
      const nextBtn = document.getElementById('ece-next');
      let current = 0;

      function goTo(index: number) {
        if (!track) return;
        current = (index + slides.length) % slides.length;
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, i) => d.classList.toggle('active', i === current));
      }

      prevBtn?.addEventListener('click', () => goTo(current - 1));
      nextBtn?.addEventListener('click', () => goTo(current + 1));
      dots.forEach((d) => {
        d.addEventListener('click', () => {
          const idx = Number((d as HTMLElement).dataset.index);
          goTo(idx);
        });
      });

      goTo(0);
    </script>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #2a1b14;
        --bg-card: #3a2620;
        --fg: #f5e6d5;
        --muted: #b8a491;
        --border: #4a332a;
        --accent: #8b9d7e;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: radial-gradient(circle at 20% 0%, #4a2a1d 0%, var(--bg) 60%);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
      }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
      .topnav { margin-bottom: 2rem; font-size: 0.9rem; }
      .topnav a { color: var(--muted); text-decoration: none; }
      .topnav a:hover { color: var(--fg); }
      .hero { margin-bottom: 2.5rem; }
      .badge {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.2rem 0.6rem;
        margin-bottom: 1rem;
      }
      h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 0.5rem; letter-spacing: -0.02em; }
      .tagline { color: var(--muted); font-size: 1.1rem; margin: 0; }
      .dashboard { margin: 3rem 0; padding-top: 2rem; border-top: 1px solid var(--border); }
      .dashboard:first-of-type { border-top: none; padding-top: 0; }
      .dashboard h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
      .desc { color: var(--muted); margin: 0 0 1.25rem; line-height: 1.5; }
      .embed {
        width: 100%;
        aspect-ratio: 600 / 373.5;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-card);
      }
      .embed-note { display: flex; justify-content: flex-end; gap: 1.5rem; color: var(--muted); font-size: 0.85rem; margin-top: 0.5rem; flex-wrap: wrap; }
      .embed-note a { color: var(--accent); }
      .yt-link { color: #ff6b6b; }
      footer { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); text-align: center; color: var(--muted); font-size: 0.9rem; }
      footer a { color: var(--fg); text-decoration: none; border-bottom: 1px dashed var(--muted); }
      .copy { margin-top: 0.5rem; font-size: 0.8rem; }

      /* World Challenge Dataviz section */
      .wc-section { margin: 4rem 0 3rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
      .wc-header { margin-bottom: 1.5rem; }
      .wc-header h2 { font-size: 1.75rem; margin: 0 0 0.5rem; }
      .wc-card { background: var(--bg-card); border: 1px solid var(--border); border-top: 3px solid var(--accent); border-radius: 14px; padding: 1.5rem; margin-bottom: 2rem; }
      .wc-card h3 { margin: 0 0 0.75rem; font-size: 1.3rem; }
      .wc-card .desc { color: var(--fg); line-height: 1.6; margin: 0 0 1.25rem; }
      .wc-note { color: var(--muted); font-size: 0.85rem; font-style: italic; margin: 1rem 0 0; }

      /* ECE carousel section */
      .ece-section { margin: 4rem 0 3rem; padding-top: 2.5rem; border-top: 1px solid var(--border); }
      .ece-header { margin-bottom: 1.5rem; }
      .ece-header h2 { font-size: 1.75rem; margin: 0 0 0.5rem; }
      .tagline-sub { color: var(--muted); line-height: 1.6; margin: 0; max-width: 640px; }

      .carousel { position: relative; overflow: hidden; border-radius: 14px; }
      .carousel-track {
        display: flex;
        transition: transform 0.35s ease;
      }
      .slide {
        flex: 0 0 100%;
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: 1.5rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 1.5rem;
      }
      .slide-meta { display: flex; flex-direction: column; }
      .ep-badge {
        display: inline-block;
        align-self: flex-start;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.15rem 0.5rem;
        margin-bottom: 0.75rem;
      }
      .slide-meta h3 { margin: 0 0 0.6rem; font-size: 1.3rem; }
      .slide-desc { color: var(--fg); line-height: 1.6; margin: 0 0 1rem; font-size: 0.95rem; }
      .students { color: var(--muted); font-size: 0.85rem; line-height: 1.5; margin: 0 0 1.25rem; }
      .students-label { color: var(--accent); font-weight: 600; }
      .btn-open {
        display: inline-block;
        align-self: flex-start;
        margin-top: auto;
        color: var(--accent);
        font-size: 0.85rem;
        text-decoration: none;
        border-bottom: 1px dashed var(--accent);
      }
      .btn-open:hover { border-bottom-style: solid; }
      .slide-embed .embed {
        width: 100%;
        aspect-ratio: 600 / 373.5;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--bg);
      }

      .nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--fg);
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        font-size: 1.4rem;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
      }
      .nav:hover { background: var(--border); }
      .nav.prev { left: 0.75rem; }
      .nav.next { right: 0.75rem; }

      .dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem; }
      .dot {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        border: 1px solid var(--border);
        background: transparent;
        cursor: pointer;
        padding: 0;
      }
      .dot.active { background: var(--accent); border-color: var(--accent); }

      @media (max-width: 720px) {
        .slide { grid-template-columns: 1fr; }
      }
    </style>
  </body>
</html>
