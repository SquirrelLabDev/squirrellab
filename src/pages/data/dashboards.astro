    src: 'https://app.powerbi.com/view?r=eyJrIjoiNDJiNjljM2YtNjlmNi00YjI5LThmNTUtMDc4NTY4Y2IwOTE3IiwidCI6Ijk1MWQxZWNhLTk2MGYtNDUwMS05MGY4LThkN2RhYjM0NjBkNiIsImMiOjh9',
    students: ['Elika Allary', 'Mouna Chihab', 'Dorian Lartigue', 'Isabelle Lin'],
  },
  {
    ep: 4,
    title: 'Pokémon',
    desc: "Preuve qu'on peut faire des rapports Power BI sur tout ! Cerise sur le gâteau : images dynamiques et musiques intégrées directement aux pages, via la custom viz HTML Viewer.",
    src: 'https://app.powerbi.com/view?r=eyJrIjoiZTUxZmJhOTMtMTExZS00MWEwLTgyMzMtN2QwMWU4N2U5MzM0IiwidCI6Ijk1MWQxZWNhLTk2MGYtNDUwMS05MGY4LThkN2RhYjM0NjBkNiIsImMiOjh9',
    students: ['Amine Benyoucef', 'Souheil Bouderbala', 'Jad Bourhabi', 'Hamza Laisne'],
  },
  {
    ep: 5,
    title: 'Inazuma Eleven',
    desc: "Le travail réalisé autour de la franchise de jeux vidéo/manga de football Inazuma Eleven. Design épuré et affichage dynamique des joueurs, classe !",
    src: 'https://app.powerbi.com/view?r=eyJrIjoiNWY2YmU4OWItMzgyYi00ZmNhLTgyNjMtYjhkMWVkYThlZDAyIiwidCI6Ijk1MWQxZWNhLTk2MGYtNDUwMS05MGY4LThkN2RhYjM0NjBkNiIsImMiOjh9',
    students: ['Cenzo Halbeher', 'Pierre Hamonic', 'Adrien Hubert'],
  },
  {
