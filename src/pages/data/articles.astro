---
import HomeLogo from '../../components/HomeLogo.astro';
import articles from '../../data/articles.json';
import { formatDate } from '../../lib/feed';
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Articles de Matthieu Rancinan — astuces Power BI et Power Query." />
    <title>Articles — Matthieu Rancinan</title>
  </head>
  <body>
    <HomeLogo />
    <main>
      <nav class="topnav"><a href="/data">← Réalisations Data</a></nav>
      <header>
        <div class="badge">Power BI</div>
        <h1>Articles</h1>
        <p class="tagline">Analyses, tutoriels et retours d'expérience.</p>
      </header>

      <div class="search">
        <input type="search" id="search" placeholder="Rechercher un article ou un #tag…" aria-label="Rechercher" />
        <p id="no-result" hidden>Aucun article ne correspond.</p>
      </div>

      {articles.map((a) => (
        <article
          class="article-card"
          id={a.slug}
          data-tags={((a as any).tags ?? []).join(' ').toLowerCase()}
          data-title={a.title.toLowerCase()}
        >
          <h2>
            {a.title}
            <a class="permalink" href={`#${a.slug}`} data-slug={a.slug} title="Copier le lien de cet article" aria-label="Copier le lien de cet article">🔗</a>
          </h2>
          <time datetime={a.date} style="display:block;color:var(--muted);font-size:0.85rem;margin:0 0 0.75rem">Publié le {formatDate(a.date)}</time>
          {((a as any).tags ?? []).length > 0 && (
            <div class="tags">
              {((a as any).tags as string[]).map((t) => (
                <button type="button" class="tag" data-tag={t.toLowerCase()}>#{t}</button>
              ))}
            </div>
          )}
          <div class="body" set:html={a.html} />
        </article>
      ))}

      <footer>
        <p><a href="/data">← Réalisations Data</a></p>
        <p class="copy">© {new Date().getFullYear()} Matthieu Rancinan</p>
      </footer>
    </main>
    <script>
      const input = document.getElementById('search') as HTMLInputElement;
      const noResult = document.getElementById('no-result')!;
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.article-card'));

      function applyFilter() {
        const q = input.value.trim().toLowerCase().replace(/^#/, '');
        const hashSearch = input.value.trim().startsWith('#');
        let visible = 0;
        for (const c of cards) {
          const tags = c.dataset.tags ?? '';
          const match =
            !q ||
            (hashSearch
              ? tags.split(' ').some((t) => t.includes(q))
              : (c.dataset.title ?? '').includes(q) ||
                tags.includes(q) ||
                (c.querySelector('.body')?.textContent ?? '').toLowerCase().includes(q));
          c.hidden = !match;
          if (match) visible++;
        }
        noResult.hidden = visible > 0;
        const url = new URL(location.href);
        if (input.value.trim()) url.searchParams.set('q', input.value.trim());
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }

      input.addEventListener('input', applyFilter);

      document.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        const tag = target.closest<HTMLElement>('.tag');
        if (tag) {
          input.value = '#' + tag.dataset.tag;
          applyFilter();
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }
        const link = target.closest<HTMLAnchorElement>('.permalink');
        if (link) {
          e.preventDefault();
          const url = new URL(location.href);
          url.search = '';
          url.hash = link.dataset.slug!;
          history.replaceState(null, '', url);
          try {
            await navigator.clipboard.writeText(url.toString());
            link.textContent = '✅';
            setTimeout(() => (link.textContent = '🔗'), 1500);
          } catch {}
        }
      });

      const initial = new URLSearchParams(location.search).get('q');
      if (initial) {
        input.value = initial;
        applyFilter();
      }
      // Un lien direct vers un article filtré par la recherche ne le montrerait pas : on
      // réaffiche tout et on laisse le navigateur sauter sur l'ancre.
      if (location.hash) {
        const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (el) {
          if (el.hidden) {
            input.value = '';
            applyFilter();
          }
          el.scrollIntoView();
          el.classList.add('targeted');
        }
      }
    </script>
    <style is:global>
      :root { color-scheme: dark; --bg: #2a1b14; --bg-card: #3a2620; --fg: #f5e6d5; --muted: #b8a491; --border: #4a332a; --accent: #8b9d7e; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body { background: radial-gradient(circle at 20% 0%, #4a2a1d 0%, var(--bg) 60%); color: var(--fg); font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; min-height: 100vh; }
      main { max-width: 800px; margin: 0 auto; padding: 2rem 1.5rem; }
      .topnav { margin-bottom: 2rem; font-size: 0.9rem; }
      .topnav a { color: var(--muted); text-decoration: none; }
      .topnav a:hover { color: var(--fg); }
      .badge { display: inline-block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); border: 1px solid var(--accent); border-radius: 999px; padding: 0.2rem 0.6rem; margin-bottom: 1rem; }
      h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 0.5rem; letter-spacing: -0.02em; }
      .tagline { color: var(--muted); font-size: 1.1rem; margin: 0 0 2.5rem; }
      .article-card { background: var(--bg-card); border: 1px solid var(--border); border-top: 3px solid var(--accent); border-radius: 14px; padding: 1.5rem; margin-bottom: 2rem; }
      .article-card h2 { margin: 0 0 0.75rem; font-size: 1.3rem; }
      .article-card[hidden] { display: none; }
      .article-card { scroll-margin-top: 1rem; }
      .article-card.targeted, .article-card:target { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
      .permalink { margin-left: 0.4rem; font-size: 0.8em; text-decoration: none; opacity: 0.4; }
      .article-card:hover .permalink, .permalink:focus { opacity: 1; }
      .search { margin-bottom: 2rem; }
      .search input { width: 100%; background: var(--bg-card); color: var(--fg); border: 1px solid var(--border); border-radius: 10px; padding: 0.7rem 1rem; font: inherit; }
      .search input:focus { outline: none; border-color: var(--accent); }
      #no-result { color: var(--muted); margin: 1rem 0 0; }
      .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1rem; }
      .tag { background: transparent; color: var(--accent); border: 1px solid var(--border); border-radius: 999px; padding: 0.1rem 0.6rem; font: inherit; font-size: 0.8rem; cursor: pointer; }
      .tag:hover { border-color: var(--accent); }
      .body { color: var(--fg); line-height: 1.6; }
      .body p { margin: 0 0 1.25rem; }
      .body p:last-child { margin-bottom: 0; }
      .body a { color: var(--accent); }
      .body ul { list-style: none; padding: 0; margin: 0 0 1.25rem; }
      .body li { margin-bottom: 0.5rem; }
      .body figure { margin: 0 0 1.25rem; }
      .body figure img { margin-bottom: 0.5rem; }
      .body figcaption { color: var(--muted); font-size: 0.9rem; }
      .body img { display: block; max-width: 100%; height: auto; border: 1px solid var(--border); border-radius: 10px; margin: 0 0 1.25rem; }
      .body pre {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1rem 1.25rem;
        overflow-x: auto;
        margin: 0 0 1.25rem;
      }
      .body code {
        font-family: ui-monospace, SFMono-Regular, "Cascadia Code", Consolas, monospace;
        font-size: 0.9rem;
        line-height: 1.6;
        color: #e8d9c8;
        white-space: pre;
      }
      footer { margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1.5rem; text-align: center; color: var(--muted); font-size: 0.9rem; }
      footer a { color: var(--fg); text-decoration: none; border-bottom: 1px dashed var(--muted); }
      .copy { margin-top: 0.5rem; font-size: 0.8rem; }
    </style>
  </body>
</html>
