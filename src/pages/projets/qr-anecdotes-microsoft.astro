---
import anecdotes from '../../data/anecdotes.json';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Jeu des QR Codes Microsoft — Fabrics & Power BI Days 2026. 20 anecdotes à découvrir en scannant des QR codes cachés." />
    <title>Jeu des QR Codes Microsoft — SquirrelLab</title>
  </head>
  <body>
    <main>
      <nav class="topnav">
        <a href="/creations">← Créations</a>
      </nav>

      <header class="hero">
        <div class="badge">Fabrics &amp; Power BI Days 2026</div>
        <h1>Jeu des QR Codes Microsoft</h1>
        <p class="tagline">20 anecdotes cachées à débusquer en scannant les QR codes dispersés dans l'événement.</p>
      </header>

      <section class="about">
        <p>
          Pour les <strong>Fabrics &amp; Power BI Days 2026</strong>, 20 QR codes ont été imprimés et cachés
          dans la salle. Chaque QR code renvoie vers une anecdote insolite sur l'histoire de Microsoft —
          des faits surprenants, drôles ou méconnus à découvrir au fil de la journée.
        </p>
        <p>
          Les QR codes sont accessibles depuis n'importe quel smartphone, sans application à installer.
          Il suffit de scanner et de lire !
        </p>
      </section>

      <section class="anecdotes">
        <h2>Les 20 anecdotes</h2>
        <div class="grid">
          {anecdotes.map((a) => (
            <a href={`/s/${a.slug}`} class="card" target="_blank" rel="noopener">
              <span class="num">#{a.num}</span>
              <p class="title">{a.title}</p>
              <span class="arrow">→</span>
            </a>
          ))}
        </div>
      </section>

      <footer>
        <p><a href="/creations">← Retour à SquirrelLab</a></p>
        <p class="copy">© {new Date().getFullYear()} SquirrelLab</p>
      </footer>
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #2a1b14;
        --bg-card: #3a2620;
        --fg: #f5e6d5;
        --muted: #b8a491;
        --border: #4a332a;
        --accent: #e07840;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: radial-gradient(circle at 20% 0%, #4a2a1d 0%, var(--bg) 60%);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
      }
      main { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem; }
      .topnav { margin-bottom: 2rem; font-size: 0.9rem; }
      .topnav a { color: var(--muted); text-decoration: none; }
      .topnav a:hover { color: var(--fg); }
      .hero { margin-bottom: 2.5rem; }
      .badge {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.2rem 0.6rem;
        margin-bottom: 1rem;
      }
      h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 0.5rem; letter-spacing: -0.02em; }
      .tagline { color: var(--muted); font-size: 1.1rem; margin: 0; }
      .about p { line-height: 1.7; color: var(--fg); margin: 0 0 1rem; }
      .about strong { color: var(--accent); }
      .anecdotes h2 { font-size: 1.25rem; margin: 2rem 0 1rem; }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 0.75rem;
        margin-bottom: 3rem;
      }
      .card {
        display: flex;
        flex-direction: column;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-left: 3px solid var(--accent);
        border-radius: 10px;
        padding: 1rem;
        text-decoration: none;
        color: var(--fg);
        transition: background 0.15s;
      }
      .card:hover { background: #452e26; }
      .num { font-size: 0.75rem; color: var(--accent); font-weight: 700; margin-bottom: 0.4rem; }
      .title { margin: 0; font-size: 0.9rem; line-height: 1.4; flex: 1; color: var(--fg); }
      .arrow { margin-top: 0.75rem; color: var(--muted); font-size: 0.85rem; }
      footer {
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }
      footer a { color: var(--fg); text-decoration: none; border-bottom: 1px dashed var(--muted); }
      footer a:hover { border-bottom-style: solid; }
      .copy { margin-top: 0.5rem; font-size: 0.8rem; }
    </style>
  </body>
</html>
