---
const appUrl = 'https://jolly-pebble-0de24bc03.7.azurestaticapps.net/';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="SpeechTimer — chronomètre de prise de parole pour réunions, débats et formations." />
    <title>SpeechTimer — SquirrelLab</title>
  </head>
  <body>
    <main>
      <nav class="topnav">
        <a href="/">← SquirrelLab</a>
      </nav>

      <header class="hero">
        <div class="badge">En ligne</div>
        <h1>SpeechTimer</h1>
        <p class="tagline">Chronomètre de prise de parole pour réunions, débats et formations.</p>
      </header>

      <section class="about">
        <p>
          Une application web légère pour cadrer les temps de parole : démarrage, pause, alertes
          visuelles, suivi multi-intervenants. Hébergée sur Azure Static Web Apps, accessible
          depuis n'importe quel navigateur, sans installation.
        </p>
      </section>

      <section class="embed-wrapper">
        <iframe
          class="embed"
          src={appUrl}
          title="SpeechTimer"
          loading="lazy"
          allow="microphone"
        ></iframe>
        <p class="embed-note">
          L'application ci-dessus est interactive — clique dedans pour l'utiliser.
          <a href={appUrl} target="_blank" rel="noopener">Ouvrir en plein écran ↗</a>
        </p>
      </section>

      <footer>
        <p><a href="/">← Retour à SquirrelLab</a></p>
        <p class="copy">© {new Date().getFullYear()} SquirrelLab</p>
      </footer>
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #2a1b14;
        --bg-card: #3a2620;
        --fg: #f5e6d5;
        --muted: #b8a491;
        --border: #4a332a;
        --accent: #f5b840;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: radial-gradient(circle at 20% 0%, #4a2a1d 0%, var(--bg) 60%);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
      }
      main {
        max-width: 1100px;
        width: 100%;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      .topnav { margin-bottom: 2rem; font-size: 0.9rem; }
      .topnav a { color: var(--muted); text-decoration: none; }
      .topnav a:hover { color: var(--fg); }
      .hero { margin-bottom: 1.5rem; }
      .badge {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.2rem 0.6rem;
        margin-bottom: 1rem;
      }
      h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
      }
      .tagline { color: var(--muted); font-size: 1.1rem; margin: 0; }
      .about { margin-bottom: 1.5rem; }
      .about p { line-height: 1.6; }
      .embed-wrapper { margin: 1rem 0 1.5rem; }
      .embed {
        width: 100%;
        height: min(75vh, 720px);
        min-height: 500px;
        display: block;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-card);
      }
      .embed-note {
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 0.75rem;
      }
      .embed-note a { color: var(--accent); }
      footer {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }
      footer a { color: var(--fg); text-decoration: none; border-bottom: 1px dashed var(--muted); }
      .copy { margin-top: 0.5rem; font-size: 0.8rem; }
    </style>
  </body>
</html>
