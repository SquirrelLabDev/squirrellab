<html lang="fr">
<head>
  <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="Simulateur de rentabilité entre deux véhicules d'énergies différentes (électrique, essence, diesel, bioéthanol...) — en combien d'années l'un devient plus avantageux que l'autre ?">
  <title>Électrique vs Thermique — Simulateur de rentabilité — SquirrelLab</title>
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <style>
    :root{
      --essence:#d97706;
      --elec:#0ea5e9;
      --bg:#f7f8fa;
      --card:#ffffff;
      --border:#e2e5ea;
      --text:#1f2430;
      --muted:#6b7280;
      --yellow:#fff7cc;
    }
    *{box-sizing:border-box;}
    body{
      font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
      background:var(--bg);
      color:var(--text);
      margin:0;
      padding:24px;
    }
    .wrap{max-width:1100px;margin:0 auto;}
    .topnav{margin-bottom:1.25rem;font-size:0.9rem;}
    .topnav a{color:var(--muted);text-decoration:none;}
    .topnav a:hover{color:var(--text);}
    h1{font-size:22px;margin-bottom:4px;}
    p.sub{color:var(--muted);margin-top:0;margin-bottom:24px;font-size:14px;}
    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:10px;
      padding:20px 24px;
      margin-bottom:20px;
    }
    .card h2{font-size:16px;margin:0 0 16px 0;}
    .grid-shared{
      display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:8px;
    }
    .grid-two{
      display:grid;grid-template-columns:1fr 1fr;gap:24px;
    }
    @media (max-width:700px){ .grid-two{grid-template-columns:1fr;} }
    .col-essence{border-left:4px solid var(--essence);padding-left:16px;}
    .col-elec{border-left:4px solid var(--elec);padding-left:16px;}
    .field{margin-bottom:12px;}
    .field label{
      display:block;font-size:12.5px;color:var(--muted);margin-bottom:4px;
    }
    .field input, .field select{
      width:100%;padding:7px 9px;border:1px solid var(--border);border-radius:6px;
      background:var(--yellow);font-size:14px;
    }
    .field input:focus, .field select:focus{outline:2px solid #94a3b8;}
    .field .hint{font-size:11px;color:var(--muted);margin-top:2px;}
    .badge{
      display:inline-block;font-size:12px;padding:2px 8px;border-radius:999px;
      background:#eef2f7;color:var(--muted);margin-left:6px;
    }
    .result-banner{
      display:flex;gap:24px;flex-wrap:wrap;align-items:center;
      background:#eef6ff;border:1px solid #cfe6ff;border-radius:10px;padding:16px 20px;margin-bottom:20px;
    }
    .result-banner .big{font-size:26px;font-weight:700;color:#0369a1;}
    .result-banner .lbl{font-size:12.5px;color:var(--muted);}
    .legend-row{display:flex;gap:20px;font-size:13px;margin-bottom:10px;}
    .legend-dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;}
    canvas{max-height:420px;}
    details summary{
      cursor:pointer;font-weight:600;font-size:15px;padding:6px 0;
    }
    table.detail{
      width:100%;border-collapse:collapse;font-size:12.5px;margin-top:12px;
    }
    table.detail th, table.detail td{
      border:1px solid var(--border);padding:4px 5px;text-align:center;
    }
    table.detail th{background:#f1f3f6;font-weight:600;}
    table.detail input{
      width:70px;padding:3px 4px;border:1px solid var(--border);border-radius:4px;font-size:12px;background:var(--yellow);text-align:center;
    }
    table.detail td.readonly{background:#fafafa;color:var(--muted);}
    .table-scroll{overflow-x:auto;}
    .toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
    .btn{
      background:#1f2430;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-size:13px;cursor:pointer;
    }
    .btn.secondary{background:#fff;color:#1f2430;border:1px solid var(--border);}
    .switch-row{display:flex;align-items:center;gap:10px;margin-bottom:14px;font-size:14px;}
  </style>
</head>
<body>
<div class="wrap">

  <nav class="topnav">
    <a href="/outils">← Outils</a>
  </nav>

  <h1>🚗⚡ Électrique vs Thermique — Simulateur de rentabilité</h1>
  <p class="sub">Comparez le coût cumulé (et le CO2) de deux véhicules, quelles que soient leurs énergies — électrique, essence, diesel, bioéthanol... — et voyez en combien d'années l'un devient plus avantageux que l'autre.</p>

  <!-- Paramètres communs -->
  <div class="card">
    <h2>Paramètres communs</h2>
    <div class="grid-shared">
      <div class="field">
        <label>Kilométrage par an (km/an)</label>
        <input type="number" id="kmParAn" value="12000" step="500">
      </div>
      <div class="field">
        <label>Nombre d'années à projeter</label>
        <input type="number" id="nbAnnees" value="15" min="1" max="30">
      </div>
    </div>
  </div>

  <!-- Paramètres véhicules -->
  <div class="card">
    <h2>Paramètres véhicules</h2>
    <div class="grid-two">
      <div class="col-essence">
        <div class="field">
          <label>Nom de l'énergie</label>
          <input type="text" id="nomA" value="Thermique" maxlength="24">
        </div>
        <div class="field">
          <label>Type d'énergie</label>
          <select id="typeA">
            <option value="liquide" selected>Carburant liquide (€/L)</option>
            <option value="electrique">Électrique (€/kWh)</option>
          </select>
        </div>
        <div class="field">
          <label>Prix d'achat du véhicule (€)</label>
          <input type="number" id="achatA" value="12000" step="100">
        </div>
        <div class="field type-liquide" data-side="A">
          <label>Prix du litre (€/L)</label>
          <input type="number" id="prixLitreA" value="2.25" step="0.01">
        </div>
        <div class="field type-liquide" data-side="A">
          <label>Consommation moyenne (L/100km)</label>
          <input type="number" id="consoL100A" value="6" step="0.1">
        </div>
        <div class="field type-electrique" data-side="A" style="display:none;">
          <label>Prix du kWh (€/kWh)</label>
          <input type="number" id="prixKwhA" value="0.05" step="0.001">
        </div>
        <div class="field type-electrique" data-side="A" style="display:none;">
          <label>Autonomie de référence</label>
          <input type="number" id="kwhRefA" value="400" step="10" style="width:48%;display:inline-block;margin-right:4%;">
          <input type="number" id="kmRefA" value="1400" step="10" style="width:48%;display:inline-block;">
          <div class="hint">kWh consommés → km parcourus (ex: 400 kWh = 1400 km)</div>
        </div>
        <div class="field">
          <label>Entretien par an (€) <span class="badge">à partir de l'année 5</span></label>
          <input type="number" id="entretienA" value="300" step="10">
        </div>
        <div class="field">
          <label>Inflation annuelle du prix de l'énergie</label>
          <input type="number" id="inflationA" value="3" step="0.1"> <span class="hint">en %, utilisée dans le tableau détaillé</span>
        </div>
      </div>
      <div class="col-elec">
        <div class="field">
          <label>Nom de l'énergie</label>
          <input type="text" id="nomB" value="Électrique" maxlength="24">
        </div>
        <div class="field">
          <label>Type d'énergie</label>
          <select id="typeB">
            <option value="liquide">Carburant liquide (€/L)</option>
            <option value="electrique" selected>Électrique (€/kWh)</option>
          </select>
        </div>
        <div class="field">
          <label>Prix d'achat du véhicule (€)</label>
          <input type="number" id="achatB" value="25000" step="100">
        </div>
        <div class="field type-liquide" data-side="B" style="display:none;">
          <label>Prix du litre (€/L)</label>
          <input type="number" id="prixLitreB" value="1.10" step="0.01">
        </div>
        <div class="field type-liquide" data-side="B" style="display:none;">
          <label>Consommation moyenne (L/100km)</label>
          <input type="number" id="consoL100B" value="7.5" step="0.1">
        </div>
        <div class="field type-electrique" data-side="B">
          <label>Prix du kWh (€/kWh)</label>
          <input type="number" id="prixKwhB" value="0.05" step="0.001">
        </div>
        <div class="field type-electrique" data-side="B">
          <label>Autonomie de référence</label>
          <input type="number" id="kwhRefB" value="400" step="10" style="width:48%;display:inline-block;margin-right:4%;">
          <input type="number" id="kmRefB" value="1400" step="10" style="width:48%;display:inline-block;">
          <div class="hint">kWh consommés → km parcourus (ex: 400 kWh = 1400 km)</div>
        </div>
        <div class="field">
          <label>Entretien par an (€) <span class="badge">à partir de l'année 5</span></label>
          <input type="number" id="entretienB" value="100" step="10">
        </div>
        <div class="field">
          <label>Inflation annuelle du prix de l'énergie</label>
          <input type="number" id="inflationB" value="2" step="0.1"> <span class="hint">en %, utilisée dans le tableau détaillé</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Paramètres CO2 -->
  <div class="card">
    <h2>Paramètres CO2</h2>
    <p class="hint" style="margin:-8px 0 14px 0;">Valeurs applicables quelle que soit l'énergie choisie ci-dessus (combustion, production d'électricité, etc.).</p>
    <div class="grid-two">
      <div class="col-essence">
        <div class="field">
          <label>CO2 à l'usage (g/km)</label>
          <input type="number" id="co2KmA" value="120" step="1">
        </div>
        <div class="field">
          <label>CO2 de production du véhicule (kg)</label>
          <input type="number" id="co2ProdA" value="6000" step="100">
        </div>
      </div>
      <div class="col-elec">
        <div class="field">
          <label>CO2 à l'usage (g/km)</label>
          <input type="number" id="co2KmB" value="0" step="1">
        </div>
        <div class="field">
          <label>CO2 de production du véhicule (kg)</label>
          <input type="number" id="co2ProdB" value="10000" step="100">
        </div>
      </div>
    </div>
  </div>

  <!-- Résultat -->
  <div class="result-banner">
    <div>
      <div class="big" id="breakevenText">—</div>
      <div class="lbl" id="breakevenLbl">Année à partir de laquelle l'électrique devient plus rentable</div>
    </div>
    <div>
      <div class="big" id="deltaFinal" style="color:#334155;">—</div>
      <div class="lbl" id="deltaFinalLbl">Économie cumulée sur l'ensemble de la période</div>
    </div>
  </div>

  <!-- Graphique -->
  <div class="card">
    <div class="switch-row">
      <label style="display:flex;align-items:center;gap:8px;">
        <input type="checkbox" id="useDetailToggle">
        Affiner avec le tableau détaillé par année (ci-dessous) plutôt que la projection simple
      </label>
    </div>
    <div class="legend-row">
      <span><span class="legend-dot" style="background:var(--essence);"></span><span id="legendCostA">Thermique — coût cumulé</span></span>
      <span><span class="legend-dot" style="background:var(--elec);"></span><span id="legendCostB">Électrique — coût cumulé</span></span>
    </div>
    <canvas id="chart"></canvas>
  </div>

  <!-- Résultat CO2 -->
  <div class="result-banner">
    <div>
      <div class="big" id="breakevenCo2Text">—</div>
      <div class="lbl" id="breakevenCo2Lbl">Année à partir de laquelle l'électrique devient plus vertueux (CO2)</div>
    </div>
    <div>
      <div class="big" id="deltaCo2Final" style="color:#334155;">—</div>
      <div class="lbl" id="deltaCo2FinalLbl">CO2 économisé sur l'ensemble de la période (kg)</div>
    </div>
  </div>

  <!-- Graphique CO2 -->
  <div class="card">
    <div class="legend-row">
      <span><span class="legend-dot" style="background:var(--essence);"></span><span id="legendCo2A">Thermique — CO2 cumulé</span></span>
      <span><span class="legend-dot" style="background:var(--elec);"></span><span id="legendCo2B">Électrique — CO2 cumulé</span></span>
    </div>
    <canvas id="chartCo2"></canvas>
  </div>

  <!-- Tableau détaillé -->
  <div class="card">
    <details id="detailDetails">
      <summary>📊 Tableau détaillé par année (optionnel, pour affiner)</summary>
      <div class="toolbar" style="margin-top:14px;">
        <span class="hint" style="color:var(--muted);font-size:13px;">
          Cases jaunes modifiables : km/an, prix unitaire, consommation, entretien (par année). Les autres colonnes sont calculées.
        </span>
        <button class="btn secondary" id="regenBtn">↻ Régénérer les valeurs par défaut</button>
      </div>

      <h3 id="headingTableA" style="color:var(--essence);font-size:14px;margin-top:20px;">Thermique</h3>
      <div class="table-scroll">
        <table class="detail" id="tableA"></table>
      </div>

      <h3 id="headingTableB" style="color:var(--elec);font-size:14px;margin-top:24px;">Électrique</h3>
      <div class="table-scroll">
        <table class="detail" id="tableB"></table>
      </div>
    </details>
  </div>

  <p class="hint" style="color:var(--muted);">
    Modèle : les frais d'entretien annuels forfaitaires (bloc "Paramètres véhicules") ne s'appliquent qu'à partir de l'année 5
    (les premières années sont supposées couvertes par la garantie constructeur).
    Le tableau détaillé permet de renseigner un entretien différent chaque année (pneus, révisions, etc.) et un kilométrage
    ou un prix de l'énergie qui varie dans le temps. Le CO2 suit toujours la projection simple (production du véhicule + émissions à l'usage),
    indépendamment du tableau détaillé.
  </p>

</div>

<script is:inline>
const $ = id => document.getElementById(id);

let chart;
let chartCo2;
let detailA = null; // array of {km, prixUnite, conso, entretien}
let detailB = null;

function readSide(side){
  return {
    nom: ($('nom'+side).value || '').trim() || (side === 'A' ? 'Énergie A' : 'Énergie B'),
    type: $('type'+side).value, // 'liquide' | 'electrique'
    achat: parseFloat($('achat'+side).value) || 0,
    prixLitre: parseFloat($('prixLitre'+side).value) || 0,
    consoL100: parseFloat($('consoL100'+side).value) || 0,
    prixKwh: parseFloat($('prixKwh'+side).value) || 0,
    kwhRef: parseFloat($('kwhRef'+side).value) || 1,
    kmRef: parseFloat($('kmRef'+side).value) || 0,
    inflation: (parseFloat($('inflation'+side).value) || 0) / 100,
    entretien: parseFloat($('entretien'+side).value) || 0,
    co2Km: parseFloat($('co2Km'+side).value) || 0,
    co2Prod: parseFloat($('co2Prod'+side).value) || 0,
  };
}

function getInputs(){
  return {
    kmParAn: parseFloat($('kmParAn').value) || 0,
    nbAnnees: Math.max(1, parseInt($('nbAnnees').value) || 1),
    A: readSide('A'),
    B: readSide('B'),
  };
}

function updateTypeVisibility(){
  ['A', 'B'].forEach(side => {
    const type = $('type'+side).value;
    document.querySelectorAll(`.field.type-liquide[data-side="${side}"]`).forEach(el => {
      el.style.display = type === 'liquide' ? '' : 'none';
    });
    document.querySelectorAll(`.field.type-electrique[data-side="${side}"]`).forEach(el => {
      el.style.display = type === 'electrique' ? '' : 'none';
    });
  });
}

// ---- Coût annuel d'énergie selon le type (carburant liquide ou électrique) ----
function annualEnergyCost(side, kmParAn){
  if(side.type === 'liquide'){
    return (side.consoL100 / 100) * side.prixLitre * kmParAn;
  }
  const kmPerKwh = side.kmRef / side.kwhRef;
  return (side.prixKwh / kmPerKwh) * kmParAn;
}

function simulateCostSide(side, kmParAn, nbAnnees){
  const annuel = annualEnergyCost(side, kmParAn);
  const arr = [];
  let cum = side.achat;
  for(let year = 1; year <= nbAnnees; year++){
    cum += annuel + (year >= 5 ? side.entretien : 0);
    arr.push(cum);
  }
  return arr;
}

// ---- Projection simple (reproduit le bloc du haut du fichier Excel) ----
function computeSimple(inputs){
  return {
    A: simulateCostSide(inputs.A, inputs.kmParAn, inputs.nbAnnees),
    B: simulateCostSide(inputs.B, inputs.kmParAn, inputs.nbAnnees),
  };
}

// ---- CO2 : production du véhicule + émissions à l'usage (g/km -> kg), projection simple uniquement ----
function simulateCO2Side(side, kmParAn, nbAnnees){
  const annuel = (side.co2Km / 1000) * kmParAn; // kg/an
  const arr = [];
  let cum = side.co2Prod;
  for(let year = 1; year <= nbAnnees; year++){
    cum += annuel;
    arr.push(cum);
  }
  return arr;
}

function computeCO2(inputs){
  return {
    A: simulateCO2Side(inputs.A, inputs.kmParAn, inputs.nbAnnees),
    B: simulateCO2Side(inputs.B, inputs.kmParAn, inputs.nbAnnees),
  };
}

// ---- Génération des valeurs par défaut du tableau détaillé, selon le type de chaque côté ----
function buildDefaultDetailForSide(side){
  const rows = [];
  let priceUnit = side.type === 'liquide' ? side.prixLitre : side.prixKwh;
  const kmPerKwhBase = side.kmRef / side.kwhRef;
  const decimals = side.type === 'liquide' ? 10000 : 100000;

  for(let year = 1; year <= side.nbAnnees; year++){
    if(year > 1){
      priceUnit = priceUnit * (1 + side.inflation);
    }
    rows.push({
      km: side.kmParAn,
      prixUnite: Math.round(priceUnit * decimals) / decimals,
      conso: side.type === 'liquide' ? side.consoL100 : Math.round(kmPerKwhBase * 100) / 100,
      entretien: year === 1 ? side.achat : (year >= 5 ? side.entretien : 0)
    });
  }
  return rows;
}

function rowCost(type, row){
  if(type === 'liquide') return (row.conso / 100) * row.prixUnite * row.km + row.entretien;
  return (row.prixUnite / row.conso) * row.km + row.entretien; // conso = km/kWh ici
}

function renderDetailTableForSide(sideLetter, side, tableEl, detailData){
  const priceLabel = side.type === 'liquide' ? 'Prix du L (€)' : 'Prix du kWh (€)';
  const consoLabel = side.type === 'liquide' ? 'Conso (L/100km)' : 'km/kWh';
  const priceStep = side.type === 'liquide' ? '0.001' : '0.0001';

  let h = `<tr><th>Année</th><th>km/an</th><th>${priceLabel}</th><th>${consoLabel}</th><th>Entretien (€)</th><th>Coût année (€)</th><th>Cumul (€)</th></tr>`;
  let cum = 0;
  const costs = [];
  detailData.forEach((row, i) => {
    const cost = rowCost(side.type, row);
    cum += cost;
    costs.push(cum);
    h += `<tr>
      <td class="readonly">${i+1}</td>
      <td><input type="number" data-side="${sideLetter}" data-row="${i}" data-field="km" value="${row.km}"></td>
      <td><input type="number" step="${priceStep}" data-side="${sideLetter}" data-row="${i}" data-field="prixUnite" value="${row.prixUnite}"></td>
      <td><input type="number" step="0.1" data-side="${sideLetter}" data-row="${i}" data-field="conso" value="${row.conso}"></td>
      <td><input type="number" data-side="${sideLetter}" data-row="${i}" data-field="entretien" value="${row.entretien}"></td>
      <td class="readonly">${cost.toFixed(2)}</td>
      <td class="readonly">${cum.toFixed(2)}</td>
    </tr>`;
  });
  tableEl.innerHTML = h;
  return costs;
}

function renderDetailTables(){
  const inputs = getInputs();

  if(!detailA || detailA.length !== inputs.nbAnnees){
    detailA = buildDefaultDetailForSide({ ...inputs.A, kmParAn: inputs.kmParAn, nbAnnees: inputs.nbAnnees });
  }
  if(!detailB || detailB.length !== inputs.nbAnnees){
    detailB = buildDefaultDetailForSide({ ...inputs.B, kmParAn: inputs.kmParAn, nbAnnees: inputs.nbAnnees });
  }

  renderDetailTableForSide('A', inputs.A, $('tableA'), detailA);
  renderDetailTableForSide('B', inputs.B, $('tableB'), detailB);

  attachTableListeners();
}

function attachTableListeners(){
  document.querySelectorAll('table.detail input').forEach(inp => {
    inp.addEventListener('change', e => {
      const t = e.target;
      const data = t.dataset.side === 'A' ? detailA : detailB;
      const row = parseInt(t.dataset.row);
      const field = t.dataset.field;
      data[row][field] = parseFloat(t.value) || 0;
      refresh(false); // recompute without rebuilding table inputs (preserve edits)
    });
  });
}

function computeFromDetail(inputs){
  let cum = 0;
  const A = detailA.map(row => { cum += rowCost(inputs.A.type, row); return cum; });
  cum = 0;
  const B = detailB.map(row => { cum += rowCost(inputs.B.type, row); return cum; });
  return { A, B };
}

function findBreakeven(arrA, arrB){
  for(let i=0; i<arrA.length; i++){
    if(arrB[i] <= arrA[i]) return i+1;
  }
  return null;
}

function refresh(rebuildTables){
  const inputs = getInputs();
  const useDetail = $('useDetailToggle').checked;

  if(rebuildTables !== false){
    detailA = null;
    detailB = null;
  }

  renderDetailTables();

  const data = useDetail ? computeFromDetail(inputs) : computeSimple(inputs);

  const years = Array.from({length: inputs.nbAnnees}, (_, i) => i+1);
  const breakYear = findBreakeven(data.A, data.B);
  $('breakevenText').textContent = breakYear ? `${breakYear} an${breakYear>1?'s':''}` : 'Non atteint';
  $('breakevenLbl').textContent = `Année à partir de laquelle ${inputs.B.nom} devient plus rentable que ${inputs.A.nom}`;

  const finalDelta = data.A[data.A.length-1] - data.B[data.B.length-1];
  $('deltaFinal').textContent = (finalDelta >= 0 ? '+' : '') + finalDelta.toFixed(0) + ' €';
  $('deltaFinal').style.color = finalDelta >= 0 ? '#0f9d58' : '#d93025';
  $('deltaFinalLbl').textContent = `Économie cumulée de ${inputs.B.nom} vs ${inputs.A.nom} à l'année ${inputs.nbAnnees} (fin de la projection)`;

  $('legendCostA').textContent = `${inputs.A.nom} — coût cumulé`;
  $('legendCostB').textContent = `${inputs.B.nom} — coût cumulé`;

  drawChart(years, data.A, data.B, inputs);

  const co2Data = computeCO2(inputs);
  const breakYearCo2 = findBreakeven(co2Data.A, co2Data.B);
  $('breakevenCo2Text').textContent = breakYearCo2 ? `${breakYearCo2} an${breakYearCo2>1?'s':''}` : 'Non atteint';
  $('breakevenCo2Lbl').textContent = `Année à partir de laquelle ${inputs.B.nom} devient plus vertueux (CO2) que ${inputs.A.nom}`;

  const finalCo2Delta = co2Data.A[co2Data.A.length-1] - co2Data.B[co2Data.B.length-1];
  $('deltaCo2Final').textContent = (finalCo2Delta >= 0 ? '+' : '') + finalCo2Delta.toFixed(0) + ' kg';
  $('deltaCo2Final').style.color = finalCo2Delta >= 0 ? '#0f9d58' : '#d93025';
  $('deltaCo2FinalLbl').textContent = `CO2 économisé (${inputs.B.nom} vs ${inputs.A.nom}) à l'année ${inputs.nbAnnees} (fin de la projection)`;

  $('legendCo2A').textContent = `${inputs.A.nom} — CO2 cumulé`;
  $('legendCo2B').textContent = `${inputs.B.nom} — CO2 cumulé`;

  drawChartCo2(years, co2Data.A, co2Data.B, inputs);

  $('headingTableA').textContent = inputs.A.nom;
  $('headingTableB').textContent = inputs.B.nom;
}

function drawChart(years, arrA, arrB, inputs){
  const ctx = document.getElementById('chart').getContext('2d');
  if(chart) chart.destroy();
  chart = new Chart(ctx, {
    type: 'line',
    data: {
      labels: years,
      datasets: [
        {
          label: `${inputs.A.nom} — coût cumulé (€)`,
          data: arrA,
          borderColor: '#d97706',
          backgroundColor: 'rgba(217,119,6,0.08)',
          fill: false,
          tension: 0.15,
          pointRadius: 2
        },
        {
          label: `${inputs.B.nom} — coût cumulé (€)`,
          data: arrB,
          borderColor: '#0ea5e9',
          backgroundColor: 'rgba(14,165,233,0.08)',
          fill: false,
          tension: 0.15,
          pointRadius: 2
        }
      ]
    },
    options: {
      responsive: true,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(0)} €`
          }
        }
      },
      scales: {
        x: { title: { display: true, text: 'Années' } },
        y: { title: { display: true, text: 'Coût cumulé (€)' } }
      }
    }
  });
}

function drawChartCo2(years, arrA, arrB, inputs){
  const ctx = document.getElementById('chartCo2').getContext('2d');
  if(chartCo2) chartCo2.destroy();
  chartCo2 = new Chart(ctx, {
    type: 'line',
    data: {
      labels: years,
      datasets: [
        {
          label: `${inputs.A.nom} — CO2 cumulé (kg)`,
          data: arrA,
          borderColor: '#d97706',
          backgroundColor: 'rgba(217,119,6,0.08)',
          fill: false,
          tension: 0.15,
          pointRadius: 2
        },
        {
          label: `${inputs.B.nom} — CO2 cumulé (kg)`,
          data: arrB,
          borderColor: '#0ea5e9',
          backgroundColor: 'rgba(14,165,233,0.08)',
          fill: false,
          tension: 0.15,
          pointRadius: 2
        }
      ]
    },
    options: {
      responsive: true,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.dataset.label}: ${ctx.parsed.y.toFixed(0)} kg`
          }
        }
      },
      scales: {
        x: { title: { display: true, text: 'Années' } },
        y: { title: { display: true, text: 'CO2 cumulé (kg)' } }
      }
    }
  });
}

document.querySelectorAll('.card input[type="number"]').forEach(inp => {
  if(inp.closest('table')) return;
  inp.addEventListener('change', () => refresh(true));
});
$('nomA').addEventListener('input', () => refresh(false));
$('nomB').addEventListener('input', () => refresh(false));
$('typeA').addEventListener('change', () => { updateTypeVisibility(); refresh(true); });
$('typeB').addEventListener('change', () => { updateTypeVisibility(); refresh(true); });
$('useDetailToggle').addEventListener('change', () => refresh(false));
$('regenBtn').addEventListener('click', () => refresh(true));

updateTypeVisibility();
refresh(true);
</script>
</body>
</html>
