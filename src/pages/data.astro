---
const dashboards = [
  {
    title: 'CV interactif',
    description: 'Mon parcours professionnel sous forme de dashboard navigable : expériences, compétences, projets.',
    src: 'https://app.powerbi.com/view?r=eyJrIjoiZDNkYjVjMWUtZmE2ZC00MWI3LWE3OWEtYTQ4YjYxMGMwZWJkIiwidCI6Ijk1MWQxZWNhLTk2MGYtNDUwMS05MGY4LThkN2RhYjM0NjBkNiIsImMiOjh9',
    iframeTitle: 'CV',
  },
  {
    title: 'Escape game data',
    description: 'Une expérience ludique en Power BI — résolution d\'énigmes via des visualisations interactives.',
    src: 'https://app.powerbi.com/view?r=eyJrIjoiODg5NTMwZjItY2MxMS00N2U2LTk4ZTEtYTZlOTYxNjc3ZjAxIiwidCI6Ijk1MWQxZWNhLTk2MGYtNDUwMS05MGY4LThkN2RhYjM0NjBkNiIsImMiOjh9',
    iframeTitle: 'ReportFinal',
  },
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Data viz et dashboards Power BI par SquirrelLab — CV interactif, expérimentations." />
    <title>Data viz — SquirrelLab</title>
  </head>
  <body>
    <main>
      <nav class="topnav">
        <a href="/">← SquirrelLab</a>
      </nav>

      <header class="hero">
        <div class="badge">Power BI</div>
        <h1>Data viz</h1>
        <p class="tagline">
          Dashboards interactifs et expérimentations data. Une autre facette du studio,
          au-delà des apps mobiles.
        </p>
      </header>

      {dashboards.map((d) => (
        <section class="dashboard">
          <h2>{d.title}</h2>
          <p class="desc">{d.description}</p>
          <div class="embed-wrapper">
            <iframe
              class="embed"
              title={d.iframeTitle}
              src={d.src}
              loading="lazy"
              allowfullscreen
            ></iframe>
            <p class="embed-note">
              <a href={d.src} target="_blank" rel="noopener">Ouvrir en plein écran ↗</a>
            </p>
          </div>
        </section>
      ))}

      <footer>
        <p><a href="/">← Retour à SquirrelLab</a></p>
        <p class="copy">© {new Date().getFullYear()} SquirrelLab</p>
      </footer>
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #2a1b14;
        --bg-card: #3a2620;
        --fg: #f5e6d5;
        --muted: #b8a491;
        --border: #4a332a;
        --accent: #8b9d7e;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: radial-gradient(circle at 20% 0%, #4a2a1d 0%, var(--bg) 60%);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      .topnav { margin-bottom: 2rem; font-size: 0.9rem; }
      .topnav a { color: var(--muted); text-decoration: none; }
      .topnav a:hover { color: var(--fg); }
      .hero { margin-bottom: 2.5rem; }
      .badge {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 999px;
        padding: 0.2rem 0.6rem;
        margin-bottom: 1rem;
      }
      h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
      }
      .tagline { color: var(--muted); font-size: 1.1rem; margin: 0; max-width: 640px; }
      .dashboard {
        margin: 3rem 0;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
      }
      .dashboard:first-of-type { border-top: none; padding-top: 0; }
      .dashboard h2 { font-size: 1.5rem; margin: 0 0 0.5rem; }
      .desc { color: var(--muted); margin: 0 0 1.25rem; line-height: 1.5; }
      .embed-wrapper { margin: 0; }
      .embed {
        width: 100%;
        aspect-ratio: 600 / 373.5;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-card);
      }
      .embed-note {
        text-align: right;
        color: var(--muted);
        font-size: 0.85rem;
        margin-top: 0.5rem;
      }
      .embed-note a { color: var(--accent); }
      footer {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }
      footer a { color: var(--fg); text-decoration: none; border-bottom: 1px dashed var(--muted); }
      .copy { margin-top: 0.5rem; font-size: 0.8rem; }
    </style>
  </body>
</html>
