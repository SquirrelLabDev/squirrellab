---
const sections = [
  {
    href: '/creations',
    label: 'Créations',
    desc: 'Apps mobiles & projets numériques.',
    links: [
      { href: '/projets/mapinblue', label: 'MapInBlue' },
      { href: '/projets/qr-anecdotes-microsoft', label: 'Jeu des QR Codes Microsoft' },
    ],
  },
  {
    href: '/outils',
    label: 'Outils',
    desc: 'Outils interactifs en ligne.',
    links: [
      { href: '/projets/speechtimer', label: 'SpeechTimer' },
      { href: '/projets/burger-quiz', label: 'Burger Quiz' },
    ],
  },
  {
    href: '/data',
    label: 'Réalisations Data',
    desc: 'Dashboards Power BI, scripts, articles et vidéos.',
    links: [
      { href: '/data/dashboards', label: 'Rapports Power BI' },
      { href: '/data/scripts', label: 'Scripts' },
      { href: '/data/articles', label: 'Articles' },
      { href: '/data/videos', label: 'Vidéos' },
    ],
  },
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="SquirrelLab — consultant data, développeur d'apps et créateur d'outils numériques." />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>SquirrelLab</title>
  </head>
  <body>
    <main>
      <header class="hero">
        <img class="logo" src="/logo.png" alt="Logo" width="120" height="120" />
        <h1>SquirrelLab</h1>
        <p class="tagline">Partage de tâtonnements, créations et découvertes numériques.</p>
      </header>


      <section class="nav-grid">
        {sections.map((s) => (
          <div class="card">
            <a href={s.href} class="card-title">
              <h2>{s.label} →</h2>
            </a>
            <p>{s.desc}</p>
            {s.links.length > 0 && (
              <ul class="sublinks">
                {s.links.map((l) => (
                  <li><a href={l.href}>{l.label}</a></li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </section>

      <footer>
        <p>Contact : <a href="mailto:contact@squirrellab.fr">contact@squirrellab.fr</a></p>
        <p><a href="/about">À propos</a></p>
        <p class="copy">© {new Date().getFullYear()} SquirrelLab</p>
      </footer>
    </main>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #2a1b14;
        --bg-card: #3a2620;
        --fg: #f5e6d5;
        --muted: #b8a491;
        --border: #4a332a;
        --accent: #e07840;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: radial-gradient(circle at 20% 0%, #4a2a1d 0%, var(--bg) 60%);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 4rem 1.5rem 2rem;
      }
      .hero { text-align: center; margin-bottom: 4rem; }
      .logo { display: block; margin: 0 auto 1rem; width: 160px; height: auto; }
      h1 {
        font-size: clamp(2.5rem, 6vw, 4rem);
        margin: 0 0 0.5rem;
        letter-spacing: -0.02em;
      }
      .tagline { color: var(--muted); font-size: 1.1rem; margin: 0; }
      .nav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
        margin-bottom: 4rem;
      }
      .card {
        display: flex;
        flex-direction: column;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-top: 3px solid var(--accent);
        border-radius: 12px;
        padding: 1.5rem;
        transition: transform 150ms ease, border-color 150ms ease;
      }
      .card:hover { transform: translateY(-2px); border-color: var(--accent); }
      .card-title { text-decoration: none; color: var(--fg); }
      .card-title:hover h2 { color: var(--accent); }
      .card h2 { margin: 0 0 0.5rem; font-size: 1.25rem; transition: color 0.15s; }
      .card p { margin: 0 0 0.75rem; color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
      .sublinks { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--border); padding-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .sublinks a { color: var(--accent); font-size: 0.85rem; text-decoration: none; border: 1px solid var(--border); border-radius: 6px; padding: 0.15rem 0.5rem; transition: background 0.15s; }
      .sublinks a:hover { background: var(--border); }
      footer {
        border-top: 1px solid var(--border);
        padding-top: 2rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }
      footer a { color: var(--fg); text-decoration: none; border-bottom: 1px dashed var(--muted); }
      footer a:hover { border-bottom-style: solid; }
      .copy { margin-top: 0.5rem; font-size: 0.8rem; }
    </style>
  </body>
</html>
