---
import HomeLogo from '../../components/HomeLogo.astro';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Jeu QR — SquirrelLab</title>
  </head>
  <body>
    <HomeLogo />
    <main>
      <section id="v-loading" class="view">
        <p class="muted">Chargement…</p>
      </section>

      <section id="v-error" class="view" hidden>
        <div class="badge badge-error">Oups</div>
        <h1 id="error-title">Impossible de continuer</h1>
        <p id="error-text" class="text"></p>
        <button id="retry-btn" class="btn" type="button" hidden>Réessayer</button>
      </section>

      <section id="v-onboard" class="view" hidden>
        <div class="badge">Jeu de QR codes</div>
        <h1 id="onboard-title">Bienvenue !</h1>
        <p class="text">Pour jouer, il te faut une équipe. Les QR codes sont à trouver <strong>dans l'ordre</strong>.</p>

        <form id="create-form" class="card" autocomplete="off">
          <h2>Créer mon équipe</h2>
          <input id="team-name" type="text" maxlength="60" placeholder="Nom de ton équipe" required />
          <button class="btn" type="submit">Créer mon équipe</button>
          <p id="create-status" class="status" role="alert"></p>
        </form>

        <form id="join-form" class="card" autocomplete="off">
          <h2>Rejoindre mon équipe</h2>
          <p class="muted">Un coéquipier a déjà créé l'équipe ? Saisis son code.</p>
          <input id="team-code" type="text" maxlength="12" placeholder="Code d'équipe" autocapitalize="characters" spellcheck="false" required />
          <button class="btn btn-secondary" type="submit">Rejoindre</button>
          <p id="join-status" class="status" role="alert"></p>
        </form>
      </section>

      <section id="v-teamcode" class="view" hidden>
        <div class="badge">Équipe créée</div>
        <h1 id="teamcode-name"></h1>
        <p class="text">Voici le code de ton équipe :</p>
        <div id="teamcode-value" class="big-code"></div>
        <p class="text">Tes coéquipiers peuvent jouer avec <strong>leur propre téléphone</strong> : ils scannent un QR code, choisissent « Rejoindre mon équipe » et saisissent ce code. La progression est partagée.</p>
        <p class="warning">⚠️ Note bien ce code. Si tu changes de navigateur ou si tu vides les données du site, tu devras le ressaisir pour retrouver ta progression.</p>
        <button id="teamcode-continue" class="btn" type="button">Continuer</button>
      </section>

      <section id="v-step" class="view" hidden>
        <div id="step-badge" class="badge"></div>
        <h1 id="step-title"></h1>
        <p id="step-text" class="text"></p>
        <a id="step-source" class="source" target="_blank" rel="noopener noreferrer" hidden>Vérifier la source →</a>
        <div id="step-hint" class="hint" hidden></div>
        <div id="step-done" class="done" hidden></div>
        <p id="step-already" class="muted" hidden>Tu avais déjà trouvé cette étape.</p>
      </section>

      <section id="v-wrong" class="view" hidden>
        <div class="badge badge-error">Pas dans l'ordre</div>
        <h1>Pas si vite !</h1>
        <p id="wrong-text" class="text"></p>
        <p class="muted">Reviens scanner celui-ci une fois le bon QR code trouvé.</p>
      </section>

      <div id="progress" class="progress" hidden></div>

      <div id="scan-bar" class="scan-bar" hidden>
        <button id="scan-btn" class="btn" type="button">📷 Scanner le QR code suivant</button>
      </div>

      <footer id="team-bar" class="team-bar" hidden>
        <span>Équipe <strong id="bar-name"></strong> · code <strong id="bar-code"></strong></span>
        <button id="switch-btn" class="link-btn" type="button">Changer d'équipe</button>
      </footer>
    </main>

    <div id="scanner" class="scanner" role="dialog" aria-modal="true" aria-label="Scanner un QR code" hidden>
      <video id="scan-video" class="scan-video" playsinline muted></video>
      <div class="scan-frame" aria-hidden="true"></div>
      <div class="scan-panel">
        <p id="scan-status" class="scan-status">Vise un QR code du jeu.</p>
        <div class="scan-actions">
          <label id="photo-label" class="btn btn-secondary" hidden>
            Prendre une photo
            <input id="photo-input" type="file" accept="image/*" capture="environment" hidden />
          </label>
          <button id="scan-close" class="btn btn-secondary" type="button">Fermer</button>
        </div>
      </div>
    </div>

    <script>
      import { apiPost } from '../../lib/qr-api.js';
      import { el, clear } from '../../lib/dom.js';
      import { cameraSupported, startCameraScan, decodePhoto, parseGameTarget } from '../../lib/qr-scanner.js';

      const params = new URLSearchParams(location.search);
      const game = (params.get('g') || '').trim();
      // Modifiable : le scanner intégré passe d'un QR code à l'autre sans recharger la page.
      let slug = (params.get('s') || '').trim();
      const STORE_KEY = `sl_qr_team_${game}`;
      const VIEWS = ['loading', 'error', 'onboard', 'teamcode', 'step', 'wrong'];
      const $ = (id) => document.getElementById(id);

      function show(name) {
        for (const v of VIEWS) $('v-' + v).hidden = v !== name;
        const playing = name === 'step' || name === 'wrong';
        $('scan-bar').hidden = !playing;
        if (!playing) {
          $('progress').hidden = true;
          $('team-bar').hidden = true;
        }
      }

      function loadTeam() {
        try {
          const raw = JSON.parse(localStorage.getItem(STORE_KEY));
          return raw && raw.code ? raw : null;
        } catch {
          return null;
        }
      }
      function saveTeam(team) {
        try {
          localStorage.setItem(STORE_KEY, JSON.stringify({ code: team.code, name: team.name }));
        } catch {
          /* navigation privée : le code reste affiché à l'écran */
        }
      }
      function clearTeam() {
        try {
          localStorage.removeItem(STORE_KEY);
        } catch {
          /* rien à faire */
        }
      }

      function fail(message, retryable = false, title = 'Impossible de continuer') {
        $('error-title').textContent = title;
        $('error-text').textContent = message;
        $('retry-btn').hidden = !retryable;
        show('error');
      }

      function renderTeamBar(team) {
        $('bar-name').textContent = team.name || '';
        $('bar-code').textContent = team.code;
        $('team-bar').hidden = false;
      }

      function renderProgress(team) {
        const box = clear($('progress'));
        for (let i = 1; i <= team.total; i++) {
          box.appendChild(el('span', { class: 'dot' + (i <= team.progress ? ' on' : '') }));
        }
        box.appendChild(el('span', { class: 'progress-label' }, `${team.progress} / ${team.total}`));
        box.hidden = false;
      }

      function onboarding(gameName) {
        $('onboard-title').textContent = gameName ? `Bienvenue dans « ${gameName} »` : 'Bienvenue !';
        $('create-status').textContent = '';
        $('join-status').textContent = '';
        show('onboard');
      }

      function showStep(data) {
        const { step, team } = data;
        $('step-badge').textContent = `QR code n°${step.n} / ${step.total}`;
        $('step-title').textContent = step.title;
        $('step-text').textContent = step.text;

        const source = $('step-source');
        if (step.source && /^https?:\/\//i.test(step.source)) {
          source.href = step.source;
          source.hidden = false;
        } else {
          source.hidden = true;
        }

        const hint = $('step-hint');
        if (step.hint) {
          hint.textContent = '';
          hint.append(el('strong', {}, 'Pour trouver le suivant : '), step.hint);
          hint.hidden = false;
        } else {
          hint.hidden = true;
        }

        const done = $('step-done');
        if (step.isLast) {
          done.textContent = '🎉 Bravo, tu as trouvé tous les QR codes ! Préviens l’organisateur.';
          done.hidden = false;
        } else {
          done.hidden = true;
        }
        $('step-already').hidden = !data.already;

        show('step');
        renderProgress(team);
        renderTeamBar(team);
      }

      function showWrong(data) {
        $('wrong-text').textContent = data.message;
        show('wrong');
        renderProgress(data.team);
        renderTeamBar(data.team);
      }

      async function run(isRetryAfterReset = false) {
        if (!game || !slug) {
          fail('Ce QR code est incomplet. Scanne-le à nouveau.');
          return;
        }
        show('loading');
        const team = loadTeam();
        const res = await apiPost('/qr/scan', { game, slug, team: team ? team.code : '' });
        const data = res.data;

        if (!data) return fail('Réponse inattendue du serveur. Réessaie dans un instant.', true);
        if (res.status === 404) return fail(data.message || 'QR code inconnu.', false, 'QR code introuvable');
        if (!res.ok) return fail(data.message || 'Erreur du serveur.', true);

        switch (data.status) {
          case 'need_team':
            return onboarding(data.name);
          case 'unknown_team':
            // Équipe supprimée côté organisateur : on repart d'un état propre (une seule fois).
            clearTeam();
            return isRetryAfterReset ? fail(data.message) : run(true);
          case 'wrong_order':
            return showWrong(data);
          case 'ok':
            return showStep(data);
          default:
            return fail('Réponse inattendue du serveur.', true);
        }
      }

      // ── Scanner intégré ───────────────────────────────────────────────────────
      let scan = null;
      let lastScanMessage = '';

      function setScanStatus(message) {
        if (message === lastScanMessage) return;
        lastScanMessage = message;
        $('scan-status').textContent = message;
      }

      function closeScanner() {
        if (scan) scan.stop();
        scan = null;
        $('scanner').hidden = true;
        document.body.classList.remove('scanning');
      }

      // Renvoie true quand le QR code lu est valide (le scan s'arrête alors).
      function handleScanned(text) {
        const target = parseGameTarget(text);
        if (!target) {
          setScanStatus("Ce n'est pas un QR code du jeu. Cherche-en un autre.");
          return false;
        }
        if (target.g !== game) {
          setScanStatus('Ce QR code appartient à une autre partie.');
          return false;
        }
        if (target.s === slug) {
          setScanStatus("Tu es déjà sur ce QR code. Scanne-en un autre.");
          return false;
        }
        slug = target.s;
        history.pushState(null, '', `?g=${encodeURIComponent(game)}&s=${encodeURIComponent(slug)}`);
        if (navigator.vibrate) navigator.vibrate(80);
        closeScanner();
        window.scrollTo(0, 0);
        run();
        return true;
      }

      async function openScanner() {
        lastScanMessage = '';
        setScanStatus('Démarrage de la caméra…');
        $('photo-label').hidden = true;
        $('scanner').hidden = false;
        document.body.classList.add('scanning');
        if (!cameraSupported()) {
          setScanStatus("La caméra n'est pas disponible ici. Prends le QR code en photo.");
          $('photo-label').hidden = false;
          return;
        }
        try {
          scan = await startCameraScan($('scan-video'), handleScanned);
          setScanStatus('Vise un QR code du jeu.');
        } catch {
          setScanStatus("Impossible d'utiliser la caméra (autorisation refusée ?). Prends le QR code en photo.");
          $('photo-label').hidden = false;
        }
      }

      $('scan-btn').addEventListener('click', openScanner);
      $('scan-close').addEventListener('click', closeScanner);
      $('photo-input').addEventListener('change', async (event) => {
        const file = event.target.files && event.target.files[0];
        event.target.value = '';
        if (!file) return;
        setScanStatus('Analyse de la photo…');
        try {
          const text = await decodePhoto(file);
          if (text) handleScanned(text);
          else setScanStatus('Aucun QR code détecté. Rapproche-toi et réessaie.');
        } catch {
          setScanStatus('Photo illisible. Réessaie.');
        }
      });

      // Bouton « précédent » : revient sur l'étape précédemment affichée.
      window.addEventListener('popstate', () => {
        const p = new URLSearchParams(location.search);
        if ((p.get('g') || '').trim() !== game) return location.reload();
        slug = (p.get('s') || '').trim();
        closeScanner();
        run();
      });

      $('retry-btn').addEventListener('click', () => run());

      $('create-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = $('create-status');
        status.textContent = 'Création…';
        const res = await apiPost('/qr/teams', { game, name: $('team-name').value });
        if (res.status !== 201 || !res.data || !res.data.team) {
          status.textContent = (res.data && res.data.message) || 'Impossible de créer l’équipe.';
          return;
        }
        const team = res.data.team;
        saveTeam(team);
        $('teamcode-name').textContent = team.name;
        $('teamcode-value').textContent = team.code;
        show('teamcode');
      });

      $('join-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const status = $('join-status');
        status.textContent = 'Recherche…';
        const res = await apiPost('/qr/teams/join', { game, code: $('team-code').value });
        if (!res.ok || !res.data || !res.data.team) {
          status.textContent = (res.data && res.data.message) || 'Impossible de rejoindre l’équipe.';
          return;
        }
        saveTeam(res.data.team);
        run();
      });

      $('teamcode-continue').addEventListener('click', () => run());

      $('switch-btn').addEventListener('click', () => {
        if (!confirm('Quitter cette équipe sur ce téléphone ? Tu pourras la rejoindre avec son code.')) return;
        clearTeam();
        run();
      });

      run();
    </script>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #2a1b14;
        --bg-card: #3a2620;
        --fg: #f5e6d5;
        --muted: #b8a491;
        --border: #4a332a;
        --accent: #e07840;
        --danger: #e2726b;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: radial-gradient(circle at 20% 0%, #4a2a1d 0%, var(--bg) 60%);
        color: var(--fg);
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
      }
      main { max-width: 600px; margin: 0 auto; padding: 4rem 1.25rem 6rem; text-align: center; }
      [hidden] { display: none !important; }
      .view { display: flex; flex-direction: column; align-items: center; }
      .badge {
        display: inline-block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;
        color: var(--accent); border: 1px solid var(--accent); border-radius: 999px;
        padding: 0.25rem 0.75rem; margin-bottom: 1.25rem;
      }
      .badge-error { color: var(--danger); border-color: var(--danger); }
      h1 { font-size: clamp(1.4rem, 5vw, 2rem); margin: 0 0 1rem; letter-spacing: -0.01em; line-height: 1.3; overflow-wrap: anywhere; }
      h2 { font-size: 1.05rem; margin: 0 0 0.75rem; }
      .text { font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.5rem; white-space: pre-line; }
      .muted { color: var(--muted); font-size: 0.9rem; margin: 0 0 1rem; }
      .source {
        color: var(--muted); font-size: 0.85rem; text-decoration: none;
        border-bottom: 1px dashed var(--border); padding-bottom: 0.1rem; margin-bottom: 1.5rem;
      }
      .source:hover { color: var(--accent); }
      .hint {
        background: var(--bg-card); border: 1px solid var(--accent); border-radius: 12px;
        padding: 0.9rem 1rem; margin: 0.5rem 0 1rem; font-size: 1rem; line-height: 1.5; width: 100%;
      }
      .hint strong { color: var(--accent); }
      .done {
        background: #24402c; border: 1px solid #7ec88a; border-radius: 12px;
        padding: 1rem; margin: 0.5rem 0 1rem; font-size: 1.05rem; width: 100%;
      }
      .card {
        background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px;
        padding: 1.1rem; margin: 0 0 1rem; width: 100%; text-align: left;
        display: flex; flex-direction: column; gap: 0.6rem;
      }
      input {
        width: 100%; background: var(--bg); border: 1px solid var(--border); color: var(--fg);
        border-radius: 8px; padding: 0.75rem; font-size: 1rem; font-family: inherit;
      }
      .btn {
        background: var(--accent); color: #1a1a1a; font-weight: 700; border: none; border-radius: 10px;
        padding: 0.75rem 1.2rem; cursor: pointer; font-size: 1rem;
      }
      .btn-secondary { background: var(--bg); color: var(--fg); border: 1px solid var(--border); }
      .btn:disabled { opacity: 0.5; }
      .status { min-height: 1.2em; margin: 0; font-size: 0.9rem; color: var(--danger); }
      .big-code {
        font-size: clamp(2rem, 12vw, 3.2rem); font-weight: 800; letter-spacing: 0.25em; color: var(--accent);
        background: var(--bg-card); border: 2px dashed var(--accent); border-radius: 14px;
        padding: 0.8rem 1.2rem 0.8rem 1.6rem; margin: 0 0 1.5rem; font-family: ui-monospace, Consolas, monospace;
      }
      .warning {
        background: #4a3418; border: 1px solid #c79a3f; border-radius: 10px; padding: 0.8rem 1rem;
        font-size: 0.9rem; line-height: 1.5; margin: 0 0 1.5rem; text-align: left;
      }
      .progress {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.35rem; margin-top: 1.5rem;
      }
      .dot { width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--border); }
      .dot.on { background: var(--accent); border-color: var(--accent); }
      .progress-label { margin-left: 0.5rem; color: var(--muted); font-size: 0.85rem; }
      .team-bar {
        position: fixed; left: 0; right: 0; bottom: 0; background: var(--bg-card); border-top: 1px solid var(--border);
        padding: 0.7rem 1rem; font-size: 0.85rem; color: var(--muted);
        display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; flex-wrap: wrap;
      }
      .team-bar strong { color: var(--fg); }
      .link-btn { background: none; border: none; color: var(--accent); cursor: pointer; font-size: 0.85rem; text-decoration: underline; }
      .scan-bar { margin-top: 1.5rem; }
      .scan-bar .btn { width: 100%; max-width: 360px; padding: 0.95rem 1.2rem; }
      .scanner { position: fixed; inset: 0; z-index: 1000; background: #000; display: flex; flex-direction: column; }
      .scan-video { flex: 1; width: 100%; min-height: 0; object-fit: cover; background: #000; }
      .scan-frame {
        position: absolute; top: 38%; left: 50%; width: min(70vw, 300px); aspect-ratio: 1; transform: translate(-50%, -50%);
        border: 3px solid var(--accent); border-radius: 18px; box-shadow: 0 0 0 100vmax rgba(0, 0, 0, 0.45); pointer-events: none;
      }
      .scan-panel { background: var(--bg-card); border-top: 1px solid var(--border); padding: 1rem 1rem 1.4rem; text-align: center; }
      .scan-status { margin: 0 0 0.8rem; min-height: 2.6em; line-height: 1.4; }
      .scan-actions { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }
      .scan-actions .btn { cursor: pointer; }
      body.scanning { overflow: hidden; }
    </style>
  </body>
</html>
